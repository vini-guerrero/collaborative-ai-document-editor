{
  "name": "chiri",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/main.ts",
    "build:web": "vite build",
    "build:server": "vite build --ssr server/main.ts --outDir dist/server",
    "build": "pnpm build:web && pnpm build:server",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "licenses:check": "node scripts/check-licenses.ts",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm licenses:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@hono/node-server": "2.1.8",
    "@tiptap/core": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "diff": "9.0.0",
    "hono": "4.13.19",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
