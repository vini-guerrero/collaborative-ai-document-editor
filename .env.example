# OpenRouter key; server-only, never sent to the browser (T4)
OPENROUTER_API_KEY=
# Model used for analysis (server allowlist, T7)
MODEL_ANALYZE=
# Model used for rewrite suggestions (server allowlist, T7)
MODEL_REWRITE=
# Model used for restructure suggestions (server allowlist, T7)
MODEL_RESTRUCTURE=
# Maximum input size in characters accepted by the proxy (T7)
MAX_INPUT_CHARS=
# Port the local Hono server listens on
PORT=
