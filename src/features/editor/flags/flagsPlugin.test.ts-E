import { getSchema } from '@tiptap/core';
import type { Node, Schema } from '@tiptap/pm/model';
import { EditorState } from '@tiptap/pm/state';
import { describe, expect, it } from 'vitest';
import { fnv1a32 } from '@/lib/hash';
import type { Flag } from '@shared/schemas/flag';
import { createEditorExtensions } from '../markdown/extensions';
import {
  clearFlagsMeta,
  createFlagsProseMirrorPlugin,
  getFlags,
  setFlagsMeta,
} from './flagsPlugin';

// Pure state, no view (T3). The schema comes from the real editor extensions.
const schema: Schema = getSchema(createEditorExtensions());

function docOf(paragraphs: readonly string[]): Node {
  return schema.node(
    'doc',
    null,
    paragraphs.map((text) => schema.node('paragraph', null, text ? [schema.text(text)] : [])),
  );
}

function stateOf(paragraphs: readonly string[]): EditorState {
  return EditorState.create({
    doc: docOf(paragraphs),
    schema,
    plugins: [createFlagsProseMirrorPlugin()],
  });
}

// Document position of the paragraph at `index` (the position before its opening token).
function paragraphPos(state: EditorState, index: number): number {
  let pos = -1;
  state.doc.forEach((_node, offset, childIndex) => {
    if (childIndex === index) {
      pos = offset;
    }
  });
  return pos;
}

// Sets flags on one paragraph the way the AI result would, with the hash of its current text.
function withFlags(state: EditorState, index: number, flags: readonly Flag[]): EditorState {
  const text = state.doc.child(index).textContent;
  const tr = setFlagsMeta(state.tr, {
    paragraphPos: paragraphPos(state, index),
    blockHash: fnv1a32(text),
    flags,
  });
  return state.apply(tr);
}

function flag(quote: string, kind: Flag['kind'] = 'clarity'): Flag {
  return { kind, quote, reason: 'Say it more plainly.' };
}

// Text currently covered by the flag, read from the document (what the user sees underlined).
function coveredText(state: EditorState, index: number): string {
  const [entry] = getFlags(state);
  if (entry === undefined) {
    throw new Error('no flag to read');
  }
  return state.doc.textBetween(entry.from, entry.to);
}

const SENTENCE = 'The cat sat on the mat.';

describe('flags state (D2, T3)', () => {
  it('stores a flag on its quoted range', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('cat')]);
    const [entry] = getFlags(state);

    expect(getFlags(state)).toHaveLength(1);
    expect(entry?.from).toBe(paragraphPos(state, 0) + 1 + 'The '.length);
    expect(coveredText(state, 0)).toBe('cat');
    expect(entry?.kind).toBe('clarity');
  });

  it('keeps at most two flags per paragraph (D16)', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('cat'), flag('mat'), flag('sat')]);

    expect(getFlags(state).map((entry) => entry.quote)).toEqual(['cat', 'mat']);
  });

  it('ignores a flag whose quote is not in the paragraph', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('dog'), flag('mat')]);

    expect(getFlags(state).map((entry) => entry.quote)).toEqual(['mat']);
  });

  it('ignores all flags computed on different text (D4)', () => {
    const doc = stateOf([SENTENCE]);
    const tr = setFlagsMeta(doc.tr, {
      paragraphPos: paragraphPos(doc, 0),
      blockHash: fnv1a32('An older version of the paragraph.'),
      flags: [flag('cat')],
    });

    expect(getFlags(doc.apply(tr))).toHaveLength(0);
  });

  it('replaces the flags of a paragraph when it is set again', () => {
    const first = withFlags(stateOf([SENTENCE]), 0, [flag('cat')]);
    const second = withFlags(first, 0, [flag('mat', 'tone')]);

    expect(getFlags(second).map((entry) => entry.quote)).toEqual(['mat']);
  });

  it('keeps flags in other paragraphs when one paragraph is set', () => {
    const one = withFlags(stateOf(['First one.', SENTENCE]), 0, [flag('First')]);
    const both = withFlags(one, 1, [flag('cat')]);

    expect(getFlags(both).map((entry) => entry.quote)).toEqual(['First', 'cat']);
  });

  it('keeps a flag when text is inserted in another paragraph before it (positions shift)', () => {
    const state = withFlags(stateOf(['Intro line', SENTENCE]), 1, [flag('cat')]);
    const before = getFlags(state)[0]?.from ?? -1;

    const next = state.apply(state.tr.insertText('XX', 2));

    expect(getFlags(next)).toHaveLength(1);
    expect(getFlags(next)[0]?.from).toBe(before + 2);
    expect(coveredText(next, 1)).toBe('cat');
  });

  it('drops flags when the flagged paragraph is edited (D4, D16)', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('cat')]);
    const from = getFlags(state)[0]?.from ?? -1;

    const next = state.apply(state.tr.insertText('big ', from));

    expect(getFlags(next)).toHaveLength(0);
  });

  it('drops flags when the flagged range is deleted', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('cat')]);
    const [entry] = getFlags(state);

    const next = state.apply(state.tr.delete(entry?.from ?? -1, entry?.to ?? -1));

    expect(getFlags(next)).toHaveLength(0);
  });

  it('drops flags in the paragraph that is split', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('mat')]);
    const at = paragraphPos(state, 0) + 1 + 'The cat sat on the '.length;

    const next = state.apply(state.tr.split(at));

    expect(next.doc.childCount).toBe(2);
    expect(getFlags(next)).toHaveLength(0);
  });

  it('keeps flags in a paragraph that is split elsewhere', () => {
    const state = withFlags(stateOf(['Intro line', SENTENCE]), 1, [flag('cat')]);
    const at = paragraphPos(state, 0) + 1 + 'Intro'.length;

    const next = state.apply(state.tr.split(at));

    expect(next.doc.childCount).toBe(3);
    expect(coveredText(next, 2)).toBe('cat');
  });

  it('drops flags in the paragraphs that are joined', () => {
    const state = withFlags(stateOf(['Intro line', SENTENCE]), 1, [flag('cat')]);

    const next = state.apply(state.tr.join(paragraphPos(state, 1)));

    expect(next.doc.childCount).toBe(1);
    expect(getFlags(next)).toHaveLength(0);
  });

  it('handles non-ASCII and emoji quotes by code unit range', () => {
    const state = withFlags(stateOf(['Café 🙂 naïve text']), 0, [flag('🙂'), flag('naïve')]);
    const entries = getFlags(state);

    expect(entries.map((entry) => entry.quote)).toEqual(['🙂', 'naïve']);
    expect(state.doc.textBetween(entries[0]?.from ?? -1, entries[0]?.to ?? -1)).toBe('🙂');
    expect(coveredText(state, 0)).toBe('🙂');
  });

  it('marks set and clear meta transactions as not undoable (D17)', () => {
    const state = stateOf([SENTENCE]);
    const setTr = setFlagsMeta(state.tr, {
      paragraphPos: paragraphPos(state, 0),
      blockHash: fnv1a32(SENTENCE),
      flags: [flag('cat')],
    });
    const clearTr = clearFlagsMeta(state.tr);

    expect(setTr.getMeta('addToHistory')).toBe(false);
    expect(clearTr.getMeta('addToHistory')).toBe(false);
  });

  it('clears one flag by id, or all flags when no id is given', () => {
    const state = withFlags(stateOf([SENTENCE]), 0, [flag('cat'), flag('mat')]);
    const firstId = getFlags(state)[0]?.id ?? '';

    const one = state.apply(clearFlagsMeta(state.tr, firstId));
    const all = state.apply(clearFlagsMeta(state.tr));

    expect(getFlags(one).map((entry) => entry.quote)).toEqual(['mat']);
    expect(getFlags(all)).toHaveLength(0);
  });
});
